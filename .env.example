# 复制为 .env，填写自己的 MiniMax key。不要提交 .env。
MINIMAX_API_KEY=

# 以下均可不填。未指定音色时，从系统音色中优先选择中文音色。
# 国际站账号需设置 MINIMAX_BASE_URL=https://api.minimax.io
# MINIMAX_BASE_URL=https://api.minimax.cn
# MINIMAX_VOICE_ID=
# MINIMAX_MODEL=speech-2.8-hd
# MINIMAX_SPEED=1
# MINIMAX_VOL=1
# MINIMAX_PITCH=0
# MINIMAX_EMOTION=
